# Entorno de ejecución: development | test | production
NODE_ENV=development

# API interna
PORT=3000
HOST=127.0.0.1
DB_PATH=./data/finanzas.db
TZ=America/Bogota

# Obligatoria: secreto compartido entre el bot y la API (mínimo 16 caracteres)
INTERNAL_API_KEY=cambia-este-secreto-por-uno-largo-y-aleatorio

# Bot de Telegram: sin token o sin IDs permitidos solo corre la API
TELEGRAM_BOT_TOKEN=
ALLOWED_TELEGRAM_USER_IDS=

# Proveedor de IA compatible con OpenAI. AI_MODEL es obligatoria para el bot; AI_API_KEY puede ir vacía en proveedores locales
# Modelo previsto: "GPT Luna 6" (ID de API pendiente). Mientras tanto se usa DeepSeek:
#   AI_BASE_URL=https://api.deepseek.com/v1
#   AI_MODEL=deepseek-chat
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
