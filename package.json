{
  "name": "finanzas-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Gestor de finanzas personales por Telegram con IA y API Express/SQLite",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --test",
    "test:watch": "node --test --watch",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "closure:run": "node scripts/run-closure.js",
    "backup": "node scripts/backup.js"
  },
  "dependencies": {
    "dayjs": "^1.11.23",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "grammy": "^1.48.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "supertest": "^7.3.2"
  }
}
